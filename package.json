{
  "name": "jeongiryang-profile-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Generated GitHub profile README dashboard for jeongiryang.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/index.ts",
    "collect": "tsx src/index.ts --collect",
    "check": "npm run build && npm run generate && node scripts/verify.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "github-markdown-css": "5.9.0",
    "markdown-it": "15.0.3"
  }
}
